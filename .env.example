# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cert_validation
PGVECTOR_ENABLED=true

# Google Cloud Platform
GCP_PROJECT_ID=koc-ai-poc-0
GCS_BUCKET_NAME=nebras-agents-doc
GCS_BUCKET_FOLDER=Cert_Agent
GCP_SERVICE_ACCOUNT_EMAIL=n8n-koc-agents-sa@koc-ai-poc-0.iam.gserviceaccount.com
GCP_SERVICE_ACCOUNT_KEY_PATH=./gcp-key.json
VERTEX_AI_LOCATION=us-central1

# OCR Service
OCR_API_URL=https://duc-genibot.azurewebsites.net/api/NebrasFlow/MorasalaTec/ocr/1800AD5C49E2420A8B695948569F7203/execute
OCR_TIMEOUT=300

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=180

# Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
WORKERS=4

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Redis (for caching and Celery)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# File Upload
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg

# Google Vertex AI Models
VERTEX_AI_TEXT_MODEL=gemini-2.0-flash-exp
VERTEX_AI_EMBEDDING_MODEL=text-embedding-004

# Signed URL Expiration (days)
SIGNED_URL_EXPIRATION_DAYS=180

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
